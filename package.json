{
  "name": "prosekit-extension-tooltip",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@11.5.1",
  "description": "A ProseKit extension for editable tooltip marks",
  "author": "wsdehl",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/shlroland/prosekit-extension-tooltip",
  "repository": {
    "type": "git",
    "url": "https://github.com/shlroland/prosekit-extension-tooltip.git"
  },
  "bugs": "https://github.com/shlroland/prosekit-extension-tooltip/issues",
  "keywords": [
    "prosekit",
    "tooltip",
    "mark",
    "editor"
  ],
  "sideEffects": [
    "./dist/style.css",
    "./src/style.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./style.css": {
      "import": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && vite build website",
    "dev": "vite website",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "pretest": "playwright install chromium",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@prosekit/core": "^0.12.2",
    "@prosekit/pm": "^0.1.17"
  },
  "peerDependencies": {
    "@prosekit/react": "^0.7.5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.5.9",
    "@ocavue/tsconfig": "^0.7.1",
    "@prosekit/basic": "^0.9.4",
    "@prosekit/extensions": "^0.17.3",
    "@prosekit/react": "^0.7.5",
    "@tsdown/css": "^0.22.1",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.1.8",
    "diffable-html-snapshot": "^0.2.0",
    "eslint": "^10.4.1",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
